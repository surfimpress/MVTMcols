__pycache__/
*.pyc
*.pyo
*.egg-info/
.DS_Store
*.archive
columns/
screenshots/
.claude/*
# Track project-level agent and skill definitions; they're project state
# (versioned, reviewed, shared across sessions), not transient working data.
!.claude/agents/
!.claude/skills/

# Database backups created by db_writer's snapshot-then-delete pattern
# These accumulate during batch runs; they're a runtime safety net,
# not source. Keep on disk, don't commit.
data/db_backups/
data/*.bak
data/*.bak-*

# Local trial/experiment dirs (one-off material; do not commit)
display_trial/

# cut_corpus.py supervisor runtime artefacts (log + state file).
# State is rebuilt from mvtm.db on first run; log is append-only.
cut_corpus.log
data/cut_corpus_state.json

# SQLite WAL sidecar files (created when journal_mode=WAL is enabled)
*.db-wal
*.db-shm

# The main DB is too big for git (~100 MB+); backed up to Drive instead
# via tools/backup_db_to_drive.sh on a LaunchAgent.
data/mvtm.db

# transcribe pipeline runtime data (DB + work tickets)
transcribe/data/transcribe.db
transcribe/data/transcribe.db.*
transcribe/data/*.bak
transcribe/data/*.bak-*
transcribe/data/db_backups/
transcribe/work/columns/*.json
transcribe/work/ads/*.json
transcribe/work/items/*.json
transcribe/work/results/
transcribe/work/slices/
transcribe/work/.DS_Store
transcribe/work/ocr_llm/
transcribe/work/classify_terms/
transcribe/work/extract_terms/
transcribe/work/reconcile_terms/
transcribe/work/tessdata_best/

# Generated by transcribe.build_repair_stats; rebuilt after every batch,
# not source (mirrors columns/transcribe_status.json's status re: columns/).
transcribe/repair_stats.json

# Generated by transcribe.build_monitor_stats, refreshed every 60s by the
# com.mvtm.ocr_llm_stats LaunchAgent -- not source.
transcribe/monitor.json

# Generated by transcribe.build_entities_stats, same LaunchAgent -- not source.
transcribe/entities.json
transcribe/entities_context.json

# Generated by transcribe.build_terminology_review_stats, same LaunchAgent -- not source.
transcribe/terminology_review.json
